[Unit]
Description=Redis In-Memory Data Store (%i)
After=network.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server {{ redis_instance_conf_path }}
ExecStop=/usr/bin/redis-cli -p {{ redis_instance.port }} shutdown
RuntimeDirectory=redis
RuntimeDirectoryMode=0755
LimitNOFILE=10032
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
