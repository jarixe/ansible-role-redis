[Unit]
Description=Redis In-Memory Data Store ({{ redis_instance.name }})
After=network.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server {{ redis_instance_conf_path }}
# SIGTERM uses Redis's graceful shutdown path without putting its password in
# the process list or systemd unit.
ExecStop=/bin/kill -s TERM $MAINPID
RuntimeDirectory=redis
RuntimeDirectoryMode=0755
LimitNOFILE=10032
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
